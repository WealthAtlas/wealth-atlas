# Wealth Atlas Environment Variables
# Copy this file to .env.local and customize for your environment

# Sync API Configuration
# Override the default sync API endpoint
# Default: https://qjtqi1soth.execute-api.us-east-1.amazonaws.com/dev
# VITE_SYNC_API_URL=https://your-custom-api-endpoint.com

# Vite Base Path Override (for GitHub Pages deployment)
# VITE_BASE_OVERRIDE=/your-repo-name/
