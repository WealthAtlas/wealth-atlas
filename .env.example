# Wealth Atlas Environment Variables
# Copy this file to .env.local and customize for your environment

# Sync API Configuration
# Required for cross-device sync — there is no default. Point it at your own
# backend (see the wealth-atlas-sync repo); without it the app runs local-only.
# Inlined by Vite at build time, so changing it needs a rebuild.
# For deployed builds this is set as a repository variable in the Pages workflow.
# VITE_SYNC_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev

# Vite Base Path Override (for GitHub Pages deployment)
# VITE_BASE_OVERRIDE=/your-repo-name/
